{
  "name": "mittwald/wordpress-ai-provider",
  "description": "Adds mittwald AI hosting to the available AI providers",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/mittwald/wordpress-ai-provider",
  "autoload": {
    "psr-4": {
      "Mittwald\\AiProvider\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mittwald\\AiProvider\\Tests\\Includes\\": "tests/includes/",
      "Mittwald\\AiProvider\\Tests\\Unit\\": "tests/unit/",
      "Mittwald\\AiProvider\\Tests\\Integration\\": "tests/integration/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "wordpress/php-ai-client": "^1.4.0",
    "phpstan/phpstan": "^2.1.37",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/extension-installer": "^1.4",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0",
    "php-http/curl-client": "^2.3"
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=512M",
    "format": "phpcs",
    "format:fix": "phpcbf",
    "package": "scripts/build-package.sh",
    "test": "@test:unit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --configuration phpunit-integration.xml.dist"
  },
  "scripts-descriptions": {
    "test": "Run the unit test suite (alias for test:unit).",
    "test:unit": "Run the unit test suite; no network access required.",
    "test:integration": "Run the integration test suite against the real mittwald AI hosting API; requires MITTWALD_AI_API_KEY."
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4"
    }
  }
}
